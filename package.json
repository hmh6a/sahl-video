{
  "name": "sahl-video",
  "version": "1.0.0",
  "description": "Simple local video trimming and editable titles",
  "author": "Sahl Video",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "dist": "electron-builder --win nsis --x64",
    "pretest": "node tests/fixtures.cjs",
    "preview": "node tests/fixtures.cjs --preview && node tests/preview-server.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.sahl.video",
    "productName": "Sahl Video",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "app/assets/icon.ico"
    },
    "nsis": {
      "artifactName": "Sahl-Video-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sahl Video",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": ["ar", "en_US"],
      "displayLanguageSelector": true
    },
    "compression": "normal"
  },
  "allowScripts": {
    "electron@40.10.6": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hmh6a/sahl-video.git"
  },
  "homepage": "https://github.com/hmh6a/sahl-video",
  "bugs": {
    "url": "https://github.com/hmh6a/sahl-video/issues"
  }
}
